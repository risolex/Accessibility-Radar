# ==============================================================================
# ACCESSIBILITY RADAR — CONFIGURAÇÃO DE IA MULTIMODAL (.env)
# ==============================================================================
# Compatível com qualquer endpoint padrão OpenAI SDK:
# - OpenRouter: https://openrouter.ai/api/v1
# - OpenAI:     https://api.openai.com/v1
# - xAI (Grok): https://api.x.ai/v1
# - Ollama:     http://localhost:11434/v1
#
# NOTA PARA JURADOS DO HACKATHON KIROWEEN:
# Se AI_API_KEY estiver vazia, o Accessibility Radar ativará automaticamente o
# "Modo Smart Mock/Fallback", analisando o DOM real e a Accessibility Tree
# extraídos pelo Playwright e gerando correções WCAG 2.2 completas sem custo!
# ==============================================================================

AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_MODEL_TEXT=openai/gpt-4o-mini
AI_MODEL_VISION=openai/gpt-4o-mini
